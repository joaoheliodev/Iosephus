# Copie para .env e gere valores aleatórios:  ./scripts/gerar_env.sh > .env
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
INGEST_API_KEY=
JWT_SECRET=
# A API não sobe com INGEST_API_KEY ou JWT_SECRET vazios ou com menos de 32 caracteres.
# INGEST_API_KEY é a chave do provedor (vale para qualquer organização): não entregue ao cliente.
# Para o coletor de cada cliente, uma chave presa à organização:  openssl rand -hex 32
# INGEST_API_KEYS=7:chave-do-coletor-de-vale-verde,8:chave-de-outro-cliente
# API_BIND=127.0.0.1
# API_PORT=8000
